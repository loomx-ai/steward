      "id": "compute.globalForwardingRules.get",
      "name": "get",
      "service": "compute",
      "method": "GET",
      "path": "/compute/v1/projects/{project}/global/forwardingRules/{forwardingRule}",
      "destructive": false,
      "input_schema": {
