      "id": "compute.urlMaps.get",
      "name": "get",
      "service": "compute",
      "method": "GET",
      "path": "/compute/v1/projects/{project}/global/urlMaps/{urlMap}",
      "destructive": false,
      "input_schema": {
        "properties": {
