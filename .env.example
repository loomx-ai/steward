STEWARD_ADDR=127.0.0.1:8585
STEWARD_DB_DRIVER=sqlite
STEWARD_DB_DSN=.steward/steward.db
# Local mode requires no login; a persistent encryption key is created next to the SQLite database.
# For network deployment, set STEWARD_AUTH_MODE=token and configure both secrets below.
# STEWARD_AUTH_MODE=token
# STEWARD_AUTH_TOKEN=replace-with-a-random-token
# STEWARD_CREDENTIAL_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
